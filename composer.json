{
    "name": "deg540/kata-examen-php",
    "description": "Kata del examen hecha en PHP",
    "type": "project",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Deg540\\KataExamen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Deg540\\KataExamen\\Test\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "test": [
            "phpunit --configuration phpunit.xml"
        ]
    }
}
